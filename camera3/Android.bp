cc_library_shared {
    name: "camera.smdk4210",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "32",

    srcs: [
        "Camera3.cpp",
        "SecFimcBackend.cpp",
        "Metadata.cpp",
        "exynos_camera.c",
        "exynos_exif.c",
        "exynos_param.c",
        "exynos_v4l2.c",
        ":smdk4210_s5p_jpeg_backend_sources",
    ],

    shared_libs: [
        "libcamera_metadata",
        "libcutils",
        "libhardware",
        "liblog",
        "libsync",
        "libutils",
    ],

    header_libs: [
        "libhardware_headers",
    ],

    include_dirs: [
        "hardware/samsung/exynos4/hal/include",
        "hardware/samsung/exynos4/hal/libs5pjpeg",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
        "-fvisibility=hidden",
        "-DEXYNOS_CAMERA_EMBEDDED_BACKEND",
    ],

    cpp_std: "gnu++17",
}
