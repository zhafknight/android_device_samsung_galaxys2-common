cc_library_shared {
    name: "camera.smdk4210",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "32",

    srcs: [
        "LegacyCamera3.cpp",
        "Metadata.cpp",
    ],

    shared_libs: [
        "libcamera_metadata",
        "libcutils",
        "libdl",
        "libhardware",
        "liblog",
        "libsync",
        "libutils",
    ],

    header_libs: [
        "libhardware_headers",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
    ],

    cpp_std: "gnu++17",
}
